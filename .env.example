# Copie este arquivo para .env e preencha os valores. O .env nunca deve ser versionado.

# Provedor do LLM: gemini (gratuito via Google AI Studio) ou claude
SRAG_LLM_PROVIDER=gemini

# Chave do Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Chave da Anthropic (apenas se SRAG_LLM_PROVIDER=claude)
ANTHROPIC_API_KEY=

# Opcionais (valores padrão em src/srag_agent/config.py)
# SRAG_LLM_MODEL=gemini-3.8-flash
# SRAG_LLM_EFFORT=medium
# SRAG_REPORTING_LAG_DAYS=14
